{
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "outDir": "dist/cjs"
  },
  "exclude": [
    "typings.d.ts",
    "index.ts",
    "node_modules",
    "__test__",
    "**/*.spec.ts",
    "jest.config.ts",
    "dist",
    "src/**/*.esm.ts"
  ]
}
